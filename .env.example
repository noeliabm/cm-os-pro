# Supabase — proyecto del workspace (crear en supabase.com o levantar local con `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — solo la usa lib/supabase/admin.ts para invitar miembros
# nuevos por email (auth.admin.inviteUserByEmail). Server-only, no exponer
# nunca con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión de Postgres para Drizzle. Usar SIEMPRE las credenciales del rol
# `authenticator` de Supabase (Settings > Database > Connection string,
# variante "Transaction" o "Session"), NUNCA la de `postgres`/superusuario:
# lib/db/index.ts hace `SET LOCAL ROLE authenticated|service_role` sobre esta
# conexión para aplicar RLS (§1.5 de ARCHITECTURE.md) — con un superusuario
# esos SET ROLE funcionarían igual pero la conexión ya tendría de por sí
# privilegios que deberían depender exclusivamente de la política RLS.
DATABASE_URL=

# Secreto compartido para /api/internal/events/drain (el cron externo que
# drena event_log debe mandar `Authorization: Bearer <este valor>`).
INTERNAL_CRON_SECRET=
